
cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Secrets: never commit these
.env
backend/.env

# Local database with your history
*.db

# Node
node_modules/
dist/
*.local

# Logs
*.log

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
EOF